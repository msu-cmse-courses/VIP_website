---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.applications == false %}
    <div style="margin: 0 0 1rem 0; padding: 0.8rem 1rem; background: rgba(92, 10, 18, 0.9); color: #fff; border-left: 4px solid rgba(255,255,255,0.5); border-radius: 0.5rem; font-weight: 600; letter-spacing: 0.02em;">
      This team is full and is no longer accepting applications at this time.
    </div>
  {% endif %}

  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>

{% assign proj_image = page.image | default: page.img %}

{% if proj_image %}
  <div style="position: relative; float: right; max-width: 300px; margin: 0 0 1rem 1rem;">
    <img src="{{ proj_image | relative_url }}" 
         alt="project image"
         style="display:block; width:100%; max-width:300px; height:auto;">
    {% if page.applications == false %}
      <div style="position: absolute; top: 12px; left: 12px; z-index: 2; pointer-events: none; background: rgba(92, 10, 18, 0.82); color: #fff; border: 1px solid rgba(255,255,255,0.35); border-radius: 999px; padding: 0.35rem 0.7rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; transform: rotate(-12deg); box-shadow: 0 2px 8px rgba(0,0,0,0.22);">
        Applications closed
      </div>
    {% endif %}
  </div>
{% endif %}

    {{ content }}

    {% if page.advisors %}

        {% assign advisor_count = page.advisors | size %}

          <h2>
            Team Advisor{% if advisor_count > 1 %}s{% endif %}
          </h2>
        {% include advisors.liquid %}
    {% endif %}
  </article>

  {% comment %}
  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}
  {% endcomment %}


  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
