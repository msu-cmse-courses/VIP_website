---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>

{% assign proj_image = page.image | default: page.img %}

{% if proj_image %}
  <img src="{{ proj_image | relative_url }}" 
       alt="project image"
       style="float:right; max-width:300px; margin:0 0 1rem 1rem;">
{% endif %}

    {{ content }}

    {% if page.advisors %}

        {% assign advisor_count = page.advisors | size %}

          <h2>
            Team Advisor{% if advisor_count > 1 %}s{% endif %}
          </h2>
        {% include advisors.liquid %}
    {% endif %}
  </article>

  {% comment %}
  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}
  {% endcomment %}


  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
